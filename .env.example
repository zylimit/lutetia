DATABASE_URL=postgresql://lutetia:lutetia@127.0.0.1:15433/lutetia
GPS51_USER=
GPS51_PWD=
GPS51_API_BASE=http://api.gps51.com/openapi
# local dev without a whitelisted IP: GPS51_API_BASE=https://www.gps51.com/webapi (unofficial, never in production)
# 本机 compose 彩排时用命令行 GPS51_DAILY_BUDGET=20 覆盖
GPS51_DAILY_BUDGET=1400
GPS51_POLL_INTERVAL_SEC=60
GPS51_MIN_CALL_GAP_SEC=6
PUSH_SILENCE_MIN=15
PUSH_LISTEN_HOST=0.0.0.0
PUSH_LISTEN_PORT=8080
# PUSH_PATH 建议设成 /gps51/push/<随机 20 位>，GPS51 后台填完整路径
PUSH_PATH=/gps51/push
DINGTEK_USER=
DINGTEK_PWD=
DINGTEK_BASE=https://cloud.dingtek.com
DINGTEK_RECONCILE_HOUR_UTC=3
STATE_DIR=./state
LOG_LEVEL=INFO
# 看板与查询 API 监听地址，默认只绑本机；绑 0.0.0.0 必须同时设 DASHBOARD_PWD 与 API_KEY
DASHBOARD_LISTEN_HOST=127.0.0.1
# 看板与查询 API 监听端口
DASHBOARD_LISTEN_PORT=8081
# 看板登录账号
DASHBOARD_USER=admin
# 看板登录密码；本机可自填，上云主机前必须换成强密码
DASHBOARD_PWD=
# 前面有反向代理（Caddy）时设 true，登录锁定按 X-Forwarded-For 最后一个值计（只在前面恰好一层受信代理时开）；直接绑公网时不要开
DASHBOARD_TRUST_PROXY=false
# 查询 API 的 Bearer key；上云前必须设成随机长串
API_KEY=
# 会话 cookie 签名密钥；留空则每次启动随机生成，重启后需重新登录
SESSION_SECRET=
