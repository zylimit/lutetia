.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
state/

# SiteMaster / Claude Code 框架家底：本机迭代、不进产品仓（与姊妹下游仓一致；缺此条时 untracked .claude/ 会把档位误升 strict、误触 three-file-sync-gate）。
.claude/

# serena MCP 本机索引与记忆，不进产品仓
.serena/

# pip install . 在容器里跑过会留下 setuptools 构建目录
build/

# 给云主机准备的环境文件副本（.env.host 之类），同样是密钥
.env.*
!.env.example

# 调用方登记文件（只含 key 摘要，仍不进仓库）；示例 example.json.sample 与 .gitkeep 照常入库
callers/*.json

# 业务数据（POI 台账等）：法国项目数据不出欧洲，只留在 fra，不推 GitHub
data/

# 前端依赖与构建产物（镜像里由 Dockerfile 的 node 阶段现场构建）
web-ui/node_modules/
web-ui/dist/
